# Copy this file to server/.env and fill in values for your environment.
# Never commit the real .env file or paste secrets into chat.

# --- Required ---
# Local: mongodb://127.0.0.1:27017/peoplesnote
# Hosted: mongodb+srv://USER:PASSWORD@CLUSTER/peoplesnote?retryWrites=true&w=majority
# Changing MONGODB_URI does not delete your local database; it only points the app elsewhere.
MONGODB_URI=mongodb://127.0.0.1:27017/peoplesnote

# Long random string used to sign session cookies (16+ characters).
SESSION_SECRET=replace-with-a-long-random-secret

# development | production
NODE_ENV=development

# --- Listen (hosting usually injects PORT) ---
PORT=3001
# Local default is 127.0.0.1. In production, omit HOST or set 0.0.0.0 so the
# platform can reach the process. Many hosts set PORT only.
HOST=127.0.0.1

# Reverse proxies in front of Node (HTTPS terminators). Default 1.
# Needed so express-session can set Secure cookies correctly via X-Forwarded-Proto.
TRUST_PROXY=1

# Force Secure cookies on/off. Default: true when NODE_ENV=production.
# COOKIE_SECURE=true

# Serve the Vite build (../dist) from this Express app. Default: true in production.
# Local API-only: leave false / development. After "npm run build" at repo root,
# you can test with NODE_ENV=production or SERVE_FRONTEND=true.
# SERVE_FRONTEND=true

# Password hashing cost (bcrypt rounds)
BCRYPT_ROUNDS=12

# --- Email (Resend) — test email + scheduled reminder emails ---
# Create an API key at https://resend.com (Dashboard → API Keys).
# Put the key only in this server .env — never commit it or paste it into chat.
RESEND_API_KEY=

# Verified sender, e.g. "PeoplesNote <reminders@yourdomain.com>"
# For quick Resend testing you can use: PeoplesNote <onboarding@resend.dev>
# (Resend may only deliver test sends to your Resend account email until a domain is verified.)
EMAIL_FROM=

# Scheduler notes (no extra env vars required):
# - The reminder email loop runs INSIDE this Node process. The backend must stay
#   running (no sleep / scale-to-zero) or due emails will not be checked.
# - When both email vars above are set, a 1-minute loop claims due notifications.
# - Status: pending → processing → submitted | retrying | failed | skipped.
# - "submitted" = provider accepted the request — not inbox delivery.
# - Temporary failures retry up to 3 attempts; permanent errors fail immediately.
# - Idempotency-Key pn-reminder/<id>/<utc> is stable across retries (~24h at Resend).
# - Multiple app instances: each runs its own loop. Mongo atomic claims prevent
#   two workers from sending the same pending row, but you still get N loops
#   polling. Prefer a single always-on instance for this learning project.
# - Account preference reminderEmailsEnabled is checked before send. Re-enabling
#   stamps reminderEmailsEnabledAt so older due notifications are skipped.
