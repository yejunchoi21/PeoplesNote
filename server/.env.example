# Copy this file to .env and adjust if needed.
# Never commit the real .env file.

MONGODB_URI=mongodb://127.0.0.1:27017/peoplesnote
PORT=3001
HOST=127.0.0.1

# Required: long random string used to sign session cookies
SESSION_SECRET=replace-with-a-long-random-secret

# production | development
NODE_ENV=development

# Password hashing cost (bcrypt rounds)
BCRYPT_ROUNDS=12

# --- Email (Resend) — test email + scheduled reminder emails ---
# Create an API key at https://resend.com (Dashboard → API Keys).
# Put the key only in this server .env — never commit it or paste it into chat.
RESEND_API_KEY=

# Verified sender, e.g. "PeoplesNote <reminders@yourdomain.com>"
# For quick Resend testing you can use: PeoplesNote <onboarding@resend.dev>
# (Resend may only deliver test sends to your Resend account email until a domain is verified.)
EMAIL_FROM=

# Scheduler notes (no extra env vars required):
# - When both vars above are set, the API process runs a 1-minute loop that
#   claims due reminder notifications and submits them via Resend.
# - Status values: pending → processing → submitted | retrying | failed | skipped.
# - "submitted" means the provider accepted the request — not inbox delivery.
# - Temporary failures (e.g. rate_limit_exceeded, 5xx) retry up to 3 attempts
#   with increasing delays; provider retry-after is honored when larger.
# - Permanent errors (validation, invalid recipient, exhausted quotas) fail
#   immediately with no automatic retry.
# - Retries reuse the same Idempotency-Key (pn-reminder/<id>/<utc>).
# - Interrupted "processing" rows older than ~15 minutes may be reclaimed once
#   with that same key. Inside Resend's ~24h idempotency window this usually
#   avoids a duplicate; after expiry a reclaim could send again (uncertain).
# - Account preference reminderEmailsEnabled is checked before send. Re-enabling
#   stamps reminderEmailsEnabledAt so older due notifications are skipped
#   (no backlog flush).
