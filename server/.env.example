# Copy this file to .env and adjust if needed.
# Never commit the real .env file.

MONGODB_URI=mongodb://127.0.0.1:27017/peoplesnote
PORT=3001
HOST=127.0.0.1

# Required: long random string used to sign session cookies
SESSION_SECRET=replace-with-a-long-random-secret

# production | development
NODE_ENV=development

# Password hashing cost (bcrypt rounds)
BCRYPT_ROUNDS=12
